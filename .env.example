# Copy to backend/.env and fill in the values you need.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/reachinbox?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change-this-to-a-long-random-string"
DEVELOPER_ACCESS_EMAIL="demo@reachinbox.ai"
DEV_LOGIN_ENABLED="false"

# Google OAuth (real login) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Slack OAuth (real rate-limit notifications) — https://api.slack.com/apps
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/auth/slack/callback"
SLACK_CHANNEL="#general"
SLACK_WEBHOOK_URL=""

# Elasticsearch (set false to use DB fallback search)
ELASTICSEARCH_ENABLED="false"
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_INDEX="reachinbox-emails"

# Ethereal SMTP — leave blank to auto-create a test account at worker startup
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="ReachInbox Scheduler"

# Scheduler / throttling
WORKER_CONCURRENCY="5"
MIN_SEND_DELAY_MS="2000"
MAX_EMAILS_PER_HOUR="200"
RATE_LIMIT_SCOPE="sender"
JOB_ATTEMPTS="5"
MAX_BATCH_SIZE="5000"
MAX_SCHEDULE_AHEAD_HOURS="720"
