# ReachInbox backend — environment template
# Copy to .env and fill in the values that are environment-specific.
# Never commit your real .env.

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/reachinbox?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
DEVELOPER_ACCESS_EMAIL="demo@reachinbox.ai"
# Enable the dev-login shortcut (set false in any real deployment).
DEV_LOGIN_ENABLED="true"

# --- Google OAuth (real login; leave blank to disable the Google button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Slack (OAuth + alerts) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI="http://localhost:4000/api/auth/slack/callback"
SLACK_CHANNEL="#general"
# Pins the OAuth authorize step to a workspace (required for private apps).
SLACK_TEAM_ID=
# Optional bot token (xoxb-) used as the OAuth fallback on private/trial workspaces.
SLACK_BOT_TOKEN=

# --- Search (Elasticsearch is optional; falls back to Postgres LIKE) ---
ELASTICSEARCH_ENABLED="false"
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_INDEX="reachinbox-emails"

# --- SMTP (Ethereal test SMTP; leave user/pass blank to auto-create a test account) ---
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="ReachInbox Scheduler"

# --- Scheduling / throughput (all configurable, nothing hardcoded) ---
WORKER_CONCURRENCY="3"
# Minimum delay between individual sends (ms) — the worker limiter.
MIN_SEND_DELAY_MS="2000"
# Hourly cap. Scope: "global" or "sender".
MAX_EMAILS_PER_HOUR="200"
RATE_LIMIT_SCOPE="sender"
JOB_ATTEMPTS=5
MAX_BATCH_SIZE=5000
MAX_SCHEDULE_AHEAD_HOURS=720
